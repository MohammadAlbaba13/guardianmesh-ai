# GuardianMesh defaults are offline and deterministic.
GUARDIANMESH_NETWORK_PROVIDER=simulated
GUARDIANMESH_REASONER=deterministic

# Optional local advisory reasoner. It never executes actions and falls back safely.
GUARDIANMESH_OLLAMA_BASE_URL=http://127.0.0.1:11434
GUARDIANMESH_OLLAMA_MODEL=
GUARDIANMESH_OLLAMA_TIMEOUT=4

# Optional local SQLite override.
# GUARDIAN_DATABASE_URL=sqlite:///backend/data/guardianmesh.db
