# GuardianMesh defaults are offline and deterministic.
GUARDIANMESH_NETWORK_PROVIDER=simulated
GUARDIANMESH_NETWORK_MODE=SIMULATION
GUARDIANMESH_REASONER=deterministic

# Optional local advisory reasoner. It never executes actions and falls back safely.
GUARDIANMESH_OLLAMA_BASE_URL=http://127.0.0.1:11434
GUARDIANMESH_OLLAMA_MODEL=
GUARDIANMESH_OLLAMA_TIMEOUT=4
GUARDIANMESH_OLLAMA_CPU_ONLY=false

# Optional real external QoD. Copy to .env in project root; never commit .env.
# Nokia application key from the Network as Code console. No OAuth client secret is used.
NOKIA_API_KEY=
GUARDIANMESH_LIVE_AUTHORIZED=false
GUARDIANMESH_PROVIDER_ENVIRONMENT=SANDBOX
GUARDIANMESH_QOD_SESSIONS_URL=https://network-as-code.p-eu.rapidapi.com/quality-on-demand/v1/sessions
# Explicit node -> approved flow mapping. This is a documented Nokia test-device example.
# Set provider=nokia and authorized=true only for an account/device you may use.
# GUARDIANMESH_QOD_BINDINGS={"hospital":{"device":{"phoneNumber":"+999991234567"},"applicationServer":{"ipv4Address":"233.252.0.2"},"qosProfile":"QOS_E","duration":300}}
GUARDIANMESH_QOD_BINDINGS={}

# Generic CAMARA QoD v1: use the operator's exact /v1/sessions URL and an already
# consented bearer access token. Operator-specific OAuth grants are not invented.
CAMARA_ACCESS_TOKEN=

# Optional local SQLite override.
# GUARDIAN_DATABASE_URL=sqlite:///backend/data/guardianmesh.db
